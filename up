*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:Poppins,sans-serif;
background:#0f0f1a;
color:white;
overflow-x:hidden;
}

.start-screen{
height:100vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
padding:20px;
}

.start-screen h1{
font-size:4rem;
font-family:'Dancing Script';
}

button{
padding:15px 30px;
border:none;
border-radius:30px;
font-size:18px;
cursor:pointer;
margin-top:20px;
}

#content{
display:none;
}

.hero{
height:100vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
}

.hero h1{
font-size:4rem;
font-family:'Dancing Script';
}

.chapter{
padding:80px 20px;
max-width:900px;
margin:auto;
text-align:center;
}

.chapter h2{
margin-bottom:20px;
font-family:'Dancing Script';
font-size:3rem;
}

.gallery{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:15px;
padding:20px;
}

.gallery img{
width:100%;
border-radius:20px;
transition:.4s;
}

.gallery img:hover{
transform:scale(1.05);
}

.paper{
background:white;
color:black;
padding:30px;
border-radius:20px;
max-width:800px;
margin:auto;
line-height:1.9;
}

.letter{
padding:60px 20px;
}

.final{
height:100vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
}

.heart{
position:fixed;
font-size:25px;
animation:fall 8s linear infinite;
}

@keyframes fall{
0%{
transform:translateY(-100px);
}
100%{
transform:translateY(110vh);
}
}
